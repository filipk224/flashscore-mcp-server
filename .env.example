# =============================================================================
# Flashscore MCP Server – Environment variables
# Copy to .env for local development. On IaaS platforms set these in the
# platform UI / secrets manager.
# =============================================================================

# Server (IaaS platforms usually inject PORT automatically)
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# Scraping behaviour
FLASHSCORE_HEADLESS=true
FLASHSCORE_MIN_DELAY_S=1.8
FLASHSCORE_MAX_CONCURRENT_PAGES=2
FLASHSCORE_NAV_TIMEOUT_MS=45000
FLASHSCORE_BASE_URL=https://www.flashscore.com

# Cloudflare Tunnel (remotely-managed). Used by docker compose --profile tunnel
# and by the Rumble deploy workflow. Create the tunnel in Zero Trust / Tunnels,
# add a public hostname -> http://flashscore-mcp:8000, then paste the token.
# CLOUDFLARE_TUNNEL_TOKEN=eyJ...
