# =============================================================================
# Flashscore MCP Server – Environment variables
# Copy to .env for local development. On IaaS platforms set these in the
# platform UI / secrets manager.
# =============================================================================

# Server (IaaS platforms usually inject PORT automatically)
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# Required for the HTTP server (Rumble / Docker / any IaaS). The process
# refuses to start without a secret of at least 16 characters.
# Clients must send: Authorization: Bearer <token>
# Generate one with: openssl rand -hex 32
FLASHSCORE_MCP_TOKEN=

# Scraping behaviour
FLASHSCORE_HEADLESS=true
# Browser pages open at once. Leave unset to size it from the run's memory and
# CPUs at startup (any size): pages = min((memory_mb - 1024) / 512, cpus),
# at least 1, at most 16, with CPU allowing at least 2. Memory comes from
# ACTOR_MEMORY_MBYTES / APIFY_MEMORY_MBYTES on Apify, else the cgroup limit,
# else MemTotal; CPUs from the cgroup quota, else memory / 4 GB on Apify, else
# the CPU count. Examples on Apify (1 CPU per 4 GB): 1 GB -> 1, 2 GB -> 2, 4 GB -> 2,
# 16 GB -> 4, 32 GB -> 8, 64 GB -> 16. The chosen values and inputs are logged
# at startup and shown under "sizing" in GET /health. Setting a number here
# overrides the computed one (the IaaS Dockerfile and docker-compose pin 2).
# FLASHSCORE_MAX_CONCURRENT_PAGES=2
FLASHSCORE_NAV_TIMEOUT_MS=45000
# A call that waits longer than this for a free browser slot fails with
# "busy, retry" instead of hanging until the client gateway times out.
FLASHSCORE_QUEUE_WAIT_S=15
# Whole get_match budget in seconds (queue wait included). Sections not loaded
# in time are reported in errors as "timeout: section not loaded within budget".
FLASHSCORE_MATCH_BUDGET_S=40
# get_h2h by team names (one season): overall time budget in seconds, and the
# ceiling for page loads plus "Show more" clicks (older seasons get more, up to this).
FLASHSCORE_H2H_BUDGET_S=40
FLASHSCORE_H2H_MAX_LOADS=15
FLASHSCORE_BASE_URL=https://www.flashscore.com

# Cloudflare Quick Tunnel (trycloudflare.com) needs no token or custom domain.
# docker compose --profile tunnel up
# The public https://*.trycloudflare.com URL is printed in cloudflared logs.
