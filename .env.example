# =============================================================================
# Flashscore MCP Server – Environment variables
# Copy to .env for local development. On IaaS platforms set these in the
# platform UI / secrets manager.
# =============================================================================

# Server (IaaS platforms usually inject PORT automatically)
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# Required for the HTTP server (Rumble / Docker / any IaaS). The process
# refuses to start without a secret of at least 16 characters.
# Clients must send: Authorization: Bearer <token>
# Generate one with: openssl rand -hex 32
FLASHSCORE_MCP_TOKEN=

# Scraping behaviour
FLASHSCORE_HEADLESS=true
FLASHSCORE_MAX_CONCURRENT_PAGES=2
FLASHSCORE_NAV_TIMEOUT_MS=45000
FLASHSCORE_BASE_URL=https://www.flashscore.com

# Cloudflare Quick Tunnel (trycloudflare.com) needs no token or custom domain.
# docker compose --profile tunnel up
# The public https://*.trycloudflare.com URL is printed in cloudflared logs.
