{
  "actorSpecification": 1,
  "name": "flashscore-mcp-server",
  "title": "Flashscore MCP Server",
  "description": "Private production MCP server for structured sports data from Flashscore.com (results, standings, fixtures, news, archives). Playwright-based, adaptable selectors.",
  "version": "0.1",
  "buildTag": "latest",
  "meta": {
    "templateId": "python-mcp-empty"
  },
  "dockerfile": "../Dockerfile.apify",
  "readme": "./README.md",
  "input": "./INPUT_SCHEMA.json",
  "output": "./OUTPUT_SCHEMA.json",
  "usesStandbyMode": true,
  "webServerMcpPath": "/mcp",
  "defaultMemoryMbytes": 2048,
  "minMemoryMbytes": 1024,
  "maxMemoryMbytes": 4096,
  "webServerSchema": "./openapi.json",
  "storages": {
    "dataset": "./dataset_schema.json",
    "keyValueStore": "./key_value_store_schema.json"
  }
}
