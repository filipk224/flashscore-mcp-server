{
  "openapi": "3.0.0",
  "info": {
    "title": "Flashscore MCP Server",
    "version": "1.0.0",
    "description": "Standby HTTP server of the Flashscore MCP Actor. It speaks MCP over Streamable HTTP (stateless, JSON responses) at /mcp and also serves a plain-text index and a JSON health check. Authenticate with an Apify API token as a Bearer token; the Apify platform checks it before the request reaches the Actor."
  },
  "tags": [
    { "name": "MCP", "description": "Model Context Protocol endpoint." },
    { "name": "Service", "description": "Index and health check." }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["Service"],
        "operationId": "getIndex",
        "summary": "Server index",
        "description": "Plain-text banner with the server version, the MCP endpoint and the health path.",
        "responses": {
          "200": {
            "description": "Plain-text banner.",
            "content": {
              "text/plain": {
                "schema": { "type": "string" },
                "example": "Flashscore MCP Server v0.2.6\nMCP endpoint: POST /mcp\nHealth: GET /health\n"
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["Service"],
        "operationId": "getHealth",
        "summary": "Health check",
        "description": "Returns ok when the server is up. It does not start a browser.",
        "responses": {
          "200": {
            "description": "Server is healthy.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" },
                "example": {
                  "status": "ok",
                  "service": "flashscore-mcp",
                  "version": "0.2.6",
                  "mcp_endpoint": "/mcp",
                  "cache": false
                }
              }
            }
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "tags": ["MCP"],
        "operationId": "postMcp",
        "summary": "MCP JSON-RPC endpoint (Streamable HTTP)",
        "description": "Send one MCP JSON-RPC message: initialize, tools/list, or tools/call. The server is stateless, so no session id is needed and every call is independent. Replies are plain JSON. Tools: list_sports, list_countries, list_leagues, get_league, get_standings, get_results_history, get_upcoming_fixtures, get_news, get_odds, list_archive_seasons, get_historical_standings, get_historical_results, get_match, get_live_matches, get_h2h, get_matches_by_day, get_team_form. When all browser slots stay busy, a tool call fails with a 'busy, retry' error instead of waiting. Send `Accept: application/json, text/event-stream`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/JsonRpcRequest" },
              "examples": {
                "initialize": {
                  "summary": "Start a session",
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 1,
                    "method": "initialize",
                    "params": {
                      "protocolVersion": "2025-03-26",
                      "capabilities": {},
                      "clientInfo": { "name": "example-client", "version": "1.0.0" }
                    }
                  }
                },
                "listTools": {
                  "summary": "List the 17 tools",
                  "value": { "jsonrpc": "2.0", "id": 2, "method": "tools/list" }
                },
                "headToHead": {
                  "summary": "Head-to-head by team names for the current season",
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 3,
                    "method": "tools/call",
                    "params": {
                      "name": "get_h2h",
                      "arguments": { "team_a": "Arsenal", "team_b": "Chelsea", "season": "2025/26" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC response. A failed tool call is still HTTP 200, with isError true in the result.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JsonRpcResponse" }
              }
            }
          },
          "202": {
            "description": "A JSON-RPC notification (such as notifications/initialized) was accepted. The body is empty."
          },
          "400": {
            "description": "The body is not a valid JSON-RPC message.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JsonRpcResponse" }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Apify API token. Returned by the Apify platform.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      },
      "get": {
        "tags": ["MCP"],
        "operationId": "getMcp",
        "summary": "Not supported",
        "description": "The server does not open a server-to-client event stream. Use POST.",
        "responses": {
          "405": { "description": "Method Not Allowed." }
        }
      },
      "delete": {
        "tags": ["MCP"],
        "operationId": "deleteMcp",
        "summary": "Not supported",
        "description": "Sessions are stateless, so there is nothing to terminate.",
        "responses": {
          "405": {
            "description": "Method Not Allowed: session termination not supported.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/JsonRpcResponse" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apifyToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Apify API token, sent as Authorization: Bearer <token>."
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "required": ["status", "service", "version", "mcp_endpoint"],
        "properties": {
          "status": { "type": "string", "example": "ok" },
          "service": { "type": "string", "example": "flashscore-mcp" },
          "version": { "type": "string", "description": "Server version.", "example": "0.2.6" },
          "mcp_endpoint": { "type": "string", "example": "/mcp" },
          "cache": { "type": "boolean", "description": "Always false: results are scraped fresh on every call." }
        }
      },
      "JsonRpcRequest": {
        "type": "object",
        "required": ["jsonrpc", "method"],
        "properties": {
          "jsonrpc": { "type": "string", "enum": ["2.0"] },
          "id": {
            "oneOf": [{ "type": "integer" }, { "type": "string" }],
            "description": "Omit for notifications."
          },
          "method": {
            "type": "string",
            "description": "For example initialize, tools/list, tools/call, notifications/initialized."
          },
          "params": { "type": "object", "additionalProperties": true }
        }
      },
      "JsonRpcResponse": {
        "type": "object",
        "required": ["jsonrpc"],
        "properties": {
          "jsonrpc": { "type": "string", "enum": ["2.0"] },
          "id": { "oneOf": [{ "type": "integer" }, { "type": "string" }], "nullable": true },
          "result": { "type": "object", "additionalProperties": true },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "integer" },
              "message": { "type": "string" }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": { "error": { "type": "string", "example": "unauthorized" } }
      }
    }
  },
  "security": [{ "apifyToken": [] }]
}
