# =============================================================================
# Flashscore MCP Server – Apify Actor Dockerfile
# =============================================================================
# Keep this file for Apify uploads / Actor deployments.
# The main Dockerfile is reserved for pure IaaS streamable-HTTP.
# =============================================================================

# Pin Playwright to the same release as requirements.txt. A floating :3.12 tag
# ships a different browser build and chromium.launch fails at runtime.
FROM apify/actor-python-playwright:3.12-1.64.1

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/usr/src/app/src \
    PORT=8000 \
    HOST=0.0.0.0 \
    FLASHSCORE_HEADLESS=true \
    FLASHSCORE_MAX_CONCURRENT_PAGES=2

# Keep the base image WORKDIR (/usr/src/app). Its ENTRYPOINT is
# ./xvfb-entrypoint.sh, resolved against WORKDIR. WORKDIR /app made
# that script missing and the Actor failed with "ENTRYPOINT/CMD could
# not be started" under LIMITED_PERMISSIONS.

COPY --chown=myuser:myuser requirements.txt pyproject.toml ./
RUN pip install --no-cache-dir -r requirements.txt \
    && pip list

COPY --chown=myuser:myuser . .

EXPOSE 8000

# Apify entrypoint (src/main.py) – keeps Standby / Actor behaviour
CMD ["python", "-m", "src.main"]
